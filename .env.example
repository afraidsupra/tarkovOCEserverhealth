# Tarkov OCE server health — ISP latency graph
# ------------------------------------------------------------------
# REQUIRED: your Discord webhook URL (the "Tarkov SYD latency" bot channel)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/XXXX/XXXX

# How often to refresh the graph (seconds). 1800 = every 30 minutes.
REFRESH_INTERVAL=1800

# How far back to plot (hours)
HOURS=24

# Bot display name
BOT_NAME=Tarkov SYD latency

# --- Optional overrides -------------------------------------------
# Chart title (default: "ISP latency -> DataPacket Sydney DC ...")
#CHART_TITLE=Tarkov SYD ISP latency

# Which probes to plot. Format: Name=IP,Name=IP (comma separated).
# "LOW" = main low-latency panel; "HIGH" = separate high-latency panel.
# Defaults (comment out to use):
#ISPS_LOW=Telstra=210.57.5.137,Optus=211.29.152.162,Aussie Broadband=159.196.255.0,TPG Telecom=203.12.160.141,Vodafone AU=101.119.57.83
#ISPS_HIGH=iPrimus (Vocus)=203.134.85.40

# Where the PNG + state live (usually leave the default /data)
#CHART_OUT=/data/tarkov_au_isp_latency.png
#STATE_DIR=/data

# Set to 1 to render the chart WITHOUT posting to Discord (smoke test)
#DRY_RUN=1
